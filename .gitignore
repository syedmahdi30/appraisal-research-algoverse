.claude/settings.local.json

# Local staging duplicate of results — contains gated EMOTIC data (see data-rules)
/algoverse-appraisal/

# EMOTIC-derived processed tables anywhere (gated — never redistribute)
**/data/processed/
paper/build/
paper-build/

# macOS metadata
.DS_Store

# Built and superseded PDFs are regenerable. Scoped deliberately: a bare *.pdf
# would silently untrack any vector figure added under paper/figures/.
/main.pdf
archive/**/*.pdf
# Generated by scripts/build-overleaf.sh from paper/ — regenerate, never hand-edit
overleaf/


# The public results bundle (EMOTIC annotation columns stripped; see scripts/package_results.py)
!release/**/*.npz

# Local-only: paper source, drafts, agent/assistant config, and working notes. The public repo is
# code, configs, tests, released results and the docs needed to re-run them.
/paper/
/archive/
/.agents/
/.claude/
